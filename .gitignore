
# ==========================================
# KiboLens - Git Ignore
# ==========================================

# ---------- Environment variables & secrets ----------
.env
.env.*
!.env.example

# Secret files and credentials
secrets/
**/secrets/
*.secret
*.key
*.pem
*.p12
*.pfx

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml/

# ---------- Node.js / React / Vite ----------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
.next/
.parcel-cache/
.turbo/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Testing ----------
coverage/
playwright-report/
test-results/
.nyc_output/

# ---------- Docker & runtime data ----------
postgres-data/
postgres_data/
prometheus-data/
prometheus_data/
grafana-data/
grafana_data/
alertmanager-data/
alertmanager_data/
docker-data/

# Local application databases
*.sqlite
*.sqlite3
*.db

# ---------- Monitoring data ----------
monitoring/prometheus/data/
monitoring/grafana/data/
monitoring/alertmanager/data/

# ---------- Logs and temporary files ----------
*.log
logs/
tmp/
temp/
*.tmp
*.pid
*.seed

# ---------- IDE and editor ----------
.vscode/
.idea/
*.code-workspace

# ---------- Operating system ----------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ---------- Backups and editor temporary files ----------
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# ---------- Local deployment files ----------
deployment/.env
deployment/.env.*
!deployment/.env.example
