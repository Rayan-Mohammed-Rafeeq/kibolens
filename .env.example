# Copy to .env and replace development/placeholder values before deployment.
#
# SECURITY NOTES:
# - Generate secrets with: openssl rand -hex 32
# - For PostgreSQL password, use hexadecimal to avoid URL encoding issues
# - Store .env with restrictive permissions: chmod 600 .env
# - Never commit .env to version control

# Environment (development | production)
KIBOLENS_ENVIRONMENT=development

# Database connection (set by Docker Compose, do not change this line)
# Password comes from POSTGRES_PASSWORD below
KIBOLENS_DATABASE_URL=postgresql+psycopg://kibolens:change-me@postgres:5432/kibolens

# CORS origins (JSON array format for multiple origins)
# Single origin: http://localhost:8080
# Multiple origins: ["http://localhost:8080","http://localhost:5173"]
KIBOLENS_CORS_ORIGINS=["http://localhost:8080"]

# Session security (generate with: openssl rand -hex 32)
KIBOLENS_SESSION_HASH_SECRET=replace-with-64-char-hex-string
KIBOLENS_SESSION_COOKIE_SECURE=false
KIBOLENS_SESSION_TTL_HOURS=12

# Email OTP Authentication
# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_placeholder_get_from_resend_dashboard
KIBOLENS_EMAIL_FROM=noreply@yourdomain.com
KIBOLENS_EMAIL_REPLY_TO=support@yourdomain.com

# Administrator allowlist (comma-separated emails)
KIBOLENS_ALLOWED_EMAILS=admin1@example.com,admin2@example.com

# OTP security (generate OTP hash secret with: openssl rand -hex 32)
KIBOLENS_OTP_HASH_SECRET=replace-with-64-char-hex-string
KIBOLENS_OTP_TTL_SECONDS=300
KIBOLENS_OTP_RESEND_COOLDOWN_SECONDS=30
KIBOLENS_OTP_MAX_ATTEMPTS=5

# Prometheus connection (internal Docker network)
KIBOLENS_PROMETHEUS_URL=http://prometheus:9090
KIBOLENS_PROMETHEUS_TIMEOUT_SECONDS=5
KIBOLENS_MONITORING_STALE_SECONDS=120

# Health thresholds (percentage)
KIBOLENS_CPU_WARNING_PERCENT=80
KIBOLENS_CPU_CRITICAL_PERCENT=90
KIBOLENS_MEMORY_WARNING_PERCENT=80
KIBOLENS_MEMORY_CRITICAL_PERCENT=90
KIBOLENS_DISK_WARNING_PERCENT=80
KIBOLENS_DISK_CRITICAL_PERCENT=90

# Alert webhook authentication (generate with: openssl rand -hex 32)
KIBOLENS_ALERT_WEBHOOK_TOKEN=replace-with-64-char-hex-string

# Path to alert token file (must match token above, for Alertmanager)
# Production: /mnt/kiboto-storage/kibolens-data/secrets/kibolens-alert-token
KIBOLENS_ALERT_TOKEN_FILE=/mnt/kiboto-storage/kibolens-data/secrets/kibolens-alert-token

# PostgreSQL credentials (used by docker-compose.yml)
# Generate password with: openssl rand -hex 24
POSTGRES_DB=kibolens
POSTGRES_USER=kibolens
POSTGRES_PASSWORD=change-me-to-48-char-hex

# Grafana admin credentials (for monitoring profile)
# Only needed if --profile monitoring is used
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-strong-password

# =============================================================================
# FREE-ONLY MULTI-PROVIDER CLOUD AI ROUTER (Gemini + Groq + OpenRouter)
# =============================================================================
# Cloud inference replaces local Ollama to avoid heating the Kibo server.
# PROVIDER HIERARCHY (strictly enforced, NEVER interleaved):
#   1. Google Gemini (primary, highest quality, exhausted FIRST)
#   2. Groq (secondary, fast inference, exhausted SECOND)
#   3. OpenRouter (tertiary, fallback, exhausted THIRD)
#
# EXHAUSTIVE PROVIDER-FIRST FALLBACK:
#   - Each provider is COMPLETELY EXHAUSTED before moving to next
#   - NO artificial attempt limits within a provider
#   - ALL eligible free models are tried in priority order (ADVANCED→BALANCED→FAST)
#   - Dynamic model discovery: fetches live catalogues from each provider's API
#   - Periodic refresh (24h default) with comprehensive last-known-good fallback
#
# Fallback is strictly provider-first:
#   TEXT:   ALL Gemini models → ALL Groq models → ALL OpenRouter :free models → Unavailable
#   VISION: ALL Gemini vision → ALL Groq vision → ALL OpenRouter :free vision → Unavailable
#   EMBED:  Gemini Embedding 2 canonical (768 dim, bounded backoff, no cross-model mixing)
#
# DYNAMIC MODEL DISCOVERY:
#   - Gemini: Fetches from https://generativelanguage.googleapis.com/v1beta/models
#     THEN filters through explicit verified free-tier eligibility list
#   - Groq: Fetches from https://api.groq.com/openai/v1/models
#     THEN filters through explicit verified free-plan eligibility list
#   - OpenRouter: Fetches from https://openrouter.ai/api/v1/models
#     THEN verifies :free suffix AND zero input/output pricing
#   - Each provider discovers eligible free models (not arbitrary counts)
#   - Comprehensive verified default registries for emergency fallback
#   - Catalogue presence alone is NOT proof of free-tier eligibility
#
# ZERO-COST ENFORCEMENT:
#   - AI_FREE_ONLY=true enforced in production
#   - Models rejected unless pricing=$0.00 or explicit free_tier=true
#   - No automatic paid model upgrades
#   - HTTP 429 model pressure continues to the next eligible model/provider

# API Keys
# - Gemini: https://aistudio.google.com/app/apikey
#   Supports both formats:
#     • Legacy AIza* keys (older format)
#     • New AQ.* authorization keys (current format)
#   Both formats are accepted; actual authorization is verified against Google's API.
# - Groq: https://console.groq.com/keys (IMPORTANT: Stay on FREE plan, no payment method)
# - OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Strict Zero-Cost Enforcement (rejects paid models and unverified pricing)
# FREE-ONLY MODE: Groq free-tier models will be used after Gemini exhaustion.
# Provider quota exhaustion skips that provider; temporary rate limits continue fallback.
KIBOLENS_AI_FREE_ONLY=true
KIBOLENS_AI_ALLOW_PAID_MODELS=false

# Router operational parameters. Requests and retries remain bounded.
KIBOLENS_AI_PROVIDER_TIMEOUT_SECONDS=45
KIBOLENS_AI_MODEL_CATALOG_REFRESH_HOURS=24

# Dynamic Model Discovery (no longer used for hard limits, kept for reference)
# The router now discovers ALL eligible free models dynamically from each provider
# These config values are legacy hints; actual discovery is comprehensive
KIBOLENS_AI_GEMINI_TEXT_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest
KIBOLENS_AI_GEMINI_VISION_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview
KIBOLENS_AI_GROQ_TEXT_MODELS=qwen/qwen3.8-27b
KIBOLENS_AI_GROQ_VISION_MODELS=qwen/qwen3.8-27b

# Canonical Embedding Model & Dimension (Gemini only, no Groq/OpenRouter embeddings)
KIBOLENS_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
KIBOLENS_GEMINI_EMBEDDING_DIMENSION=768

# Active provider: "cloud" (default) or "ollama" (legacy rollback)
KIBOLENS_LLM_PROVIDER=cloud

# Legacy Ollama Configuration (Phase 5.1 Rollback Only)
# Without cloud keys, set KIBOLENS_LLM_PROVIDER=ollama to roll back to local inference.
#
# KIBOLENS_OLLAMA_BASE_URL=http://localhost:11434
# KIBOLENS_OLLAMA_MODEL=llama3.2:3b
# KIBOLENS_LLM_TEMPERATURE=0.1
# KIBOLENS_LLM_MAX_TOKENS=2000

# RAG / Vector Database Configuration (Phase 5.2+)
# Qdrant vector database for document embeddings and RAG
# Default URL works with Docker Compose internal network
# KIBOLENS_QDRANT_URL=http://qdrant:6333
# KIBOLENS_QDRANT_TIMEOUT_SECONDS=10

# NOTE: Ollama legacy embedding models (only needed if KIBOLENS_LLM_PROVIDER=ollama):
# KIBOLENS_EMBEDDING_MODEL=all-minilm
